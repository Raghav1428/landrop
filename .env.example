# Environment is read by Node; copy values into your shell (or use node --env-file).
PORT=4173
HOST=0.0.0.0
# STORAGE_ROOT must be a dedicated LANDrop directory, not an existing personal folder.
STORAGE_ROOT=.landrop/storage
# Comma-separated additional deployment origins; no wildcards.
# ALLOWED_ORIGINS=https://landrop.example:4173
# DISK_BUDGET_BYTES=8589934592
# TEXT_BUDGET_BYTES=4194304
# MAX_ROOMS=64
# MAX_SESSIONS=1024
# TLS_KEY=./certs/key.pem
# TLS_CERT=./certs/cert.pem
