{
  "name": "landrop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"tsx watch apps/server/src/index.ts\" \"npm run dev -w @landrop/web\"",
    "build": "npm run build -w @landrop/web && npm run build -w @landrop/server",
    "start": "node apps/server/dist/index.js",
    "typecheck": "tsc --noEmit -p packages/protocol && tsc --noEmit -p apps/server && tsc --noEmit -p apps/web && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint apps packages tests",
    "test": "vitest run --exclude tests/e2e/** --exclude tests/integration/**",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "8.18.1",
    "concurrently": "9.2.5",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "5.0.5"
  }
}
